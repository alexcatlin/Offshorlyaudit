# Copy to .env.local for development. Never commit real keys.

# --- AI ---
# Anthropic API key. Secret.
ANTHROPIC_API_KEY=
# Model id. Empty = server default (current Sonnet-class model).
AUDIT_MODEL=
# live | fixture | off. Empty = live if ANTHROPIC_API_KEY is set; otherwise fixture
# outside production, off in production. Production + fixture refuses to start.
# A refused key or unknown model starts with AI off and "aiConfigError":true in /healthz.
AI_MODE=

# --- Email gate (one free audit per email) ---
# on | off. off = email still required and synced to the CRM, no one-per-email limit.
EMAIL_GATE=on
# HMAC secret for the gate key (16+ characters). Empty = random per process (the record resets
# on restart). Render generates it; never change it in production (that resets the gate).
EMAIL_HASH_SECRET=
# Append-only ledger file. Empty = in memory. Render: /var/data/audit-ledger.jsonl. Locally,
# e.g. ./.data/ledger.jsonl (the directory is created outside production; .data/ is gitignored).
LEDGER_PATH=
# Days a ledger entry is kept (30-1825).
LEDGER_RETENTION_DAYS=365
# Addresses or @domains (exact domain) that skip the gate and are never recorded. Space/comma separated.
AUDIT_ALLOWLIST=@offshorly.com
# true = also sync allow-listed audits to the CRM (Note title prefixed "[Test] ").
CRM_SYNC_ALLOWLISTED=false

# --- Twenty CRM (both empty = CRM off) ---
# Origin only. Cloud: https://api.twenty.com ; self-hosted: your server origin. https only
# (http://localhost allowed outside production).
TWENTY_API_URL=
# Twenty API key (Settings -> Developers -> API -> + Create key). Secret.
TWENTY_API_KEY=

# --- Optional data sources ---
# Google PageSpeed Insights key. Secret. Enables the Google speed checks.
PAGESPEED_API_KEY=
# Wordfence Intelligence key. DORMANT: leave empty (module targets a retired feed shape; see README).
WORDFENCE_API_KEY=

# --- Origins and embedding ---
# Public origin of this tool, e.g. https://audit.offshorly.com
PUBLIC_ORIGIN=
# Extra allowed request origins, space-separated. Dev: http://localhost:5173 http://localhost:8787
ALLOWED_ORIGINS=
# Sites allowed to iframe the tool (CSP frame-ancestors), space-separated.
ALLOWED_FRAME_ANCESTORS=https://offshorly.com https://www.offshorly.com

# --- Limits ---
RATE_LIMIT_HOURLY=5
RATE_LIMIT_DAILY=20
# AI audits per UTC day across all visitors. 50 until real cost numbers exist.
DAILY_AI_AUDITS=50
MAX_CONCURRENT_AUDITS=4
CACHE_TTL_MIN=360
# Proxy hops in front of the app (Render = 1). 0 = ignore X-Forwarded-For.
TRUST_PROXY_HOPS=1

# --- Optional features ---
# Adobe Fonts kit CSS URL. Empty = self-hosted Urbanist only.
TYPEKIT_KIT_URL=

# --- Runtime ---
PORT=8787
NODE_ENV=development
LOG_LEVEL=info
