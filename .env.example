# Copy to .env.local for development. Never commit real keys.

# --- AI ---
# Anthropic API key. Secret.
ANTHROPIC_API_KEY=
# Model id. Empty = server default (current Sonnet-class model).
AUDIT_MODEL=
# live | fixture | off. Empty = live if ANTHROPIC_API_KEY is set; otherwise fixture
# outside production, off in production. Production + fixture refuses to start.
# A refused key or unknown model starts with AI off and "aiConfigError":true in /healthz.
AI_MODE=

# --- Email gate (one free audit per email) ---
# on | off. off = email still required and synced to the CRM, no one-per-email limit.
EMAIL_GATE=on
# HMAC secret for the gate key (16+ characters). Empty = random per process (the record resets
# on restart). Render generates it; never change it in production (that resets the gate).
EMAIL_HASH_SECRET=
# Append-only ledger file. Empty = in memory. Render: /var/data/audit-ledger.jsonl. Locally,
# e.g. ./.data/ledger.jsonl (the directory is created outside production; .data/ is gitignored).
LEDGER_PATH=
# Days a ledger entry is kept (30-1825).
LEDGER_RETENTION_DAYS=365
# Addresses or @domains (exact domain) that skip the gate and are never recorded. Space/comma separated.
AUDIT_ALLOWLIST=@offshorly.com
# true = also sync allow-listed audits to the CRM (Note title prefixed "[Test] ").
CRM_SYNC_ALLOWLISTED=false

# --- Sessions, idea feedback and admin (Amendment 5 Phase 2) ---
# Hours a per-response session (share, email, feedback) lives in memory (1-72).
SESSION_TTL_HOURS=24
# Idea feedback JSONL. Empty = in memory. Render: /var/data/idea-feedback.jsonl. Locally, e.g.
# ./.data/idea-feedback.jsonl.
FEEDBACK_PATH=
# Days a feedback line is kept (1-365). The footer promises "up to a year": change the copy in
# src/content/copy.ts if you lower it.
FEEDBACK_RETENTION_DAYS=365
# Bearer token for /api/admin/* (feedback.csv, share deletion), 32+ characters. Secret.
# Empty = admin routes off (404). Render generates it.
ADMIN_TOKEN=

# --- Share links (Amendment 5 Phase 3) ---
# on | off. off = no share store; Copy link and Email me this report are hidden.
SHARE_LINKS=on
# One JSON file per shared report. Empty = in memory. Render: /var/data/reports. Locally, e.g.
# ./.data/reports (created outside production).
REPORTS_DIR=
# Days a shared report is kept (1-365).
SHARE_RETENTION_DAYS=30
# Refuse new shares (503 share_unavailable) at this many files...
SHARE_MAX_FILES=5000
# ...or when the disk has less free space than this (MB).
SHARE_MIN_FREE_MB=150

# --- Email the report (Amendment 5 Phase 4; off unless all of these are set) ---
# resend | empty (off). Email also needs an https PUBLIC_ORIGIN and SHARE_LINKS=on; anything
# missing switches it off with a warning (never a boot failure).
MAIL_PROVIDER=
# Resend API key (limit it to the sending domain). Secret.
MAIL_API_KEY=
# "Name <address>" or "address", e.g. Offshorly audit <audit@mail.offshorly.com>
MAIL_FROM=
# A monitored inbox for replies.
MAIL_REPLY_TO=
# One line of registered company details for the email footer (<=200 chars). Empty = "Offshorly Ltd".
MAIL_FOOTER_LINE=
# Report emails per UTC day across all visitors (Resend free tier: 100/day).
MAIL_DAILY_MAX=90

# --- Web-search grounding (Amendment 5 Phase 5; off unless provider and key are set) ---
# serpapi | fixture (dev/test only; refused in production) | empty (off).
SEARCH_PROVIDER=
# SerpApi key. Secret. Travels in SerpApi's query string, so the request URL is never logged.
SEARCH_API_KEY=
# Industry results cache (JSON). Empty = in memory. Render: /var/data/search-cache.json. Locally,
# e.g. ./.data/search-cache.json (the directory is created outside production).
SEARCH_CACHE_PATH=
# Days an industry's results are kept (1-30).
SEARCH_CACHE_DAYS=7
# Provider requests per UTC day (each industry refresh makes two). SerpApi free plan: 250/month.
SEARCH_DAILY_MAX=20

# --- Twenty CRM (both empty = CRM off) ---
# Origin only. Cloud: https://api.twenty.com ; self-hosted: your server origin. https only
# (http://localhost allowed outside production).
TWENTY_API_URL=
# Twenty API key (Settings -> Developers -> API -> + Create key). Secret.
TWENTY_API_KEY=

# --- Optional data sources ---
# Google PageSpeed Insights key. Secret. Enables the Google speed checks.
PAGESPEED_API_KEY=
# Wordfence Intelligence key. DORMANT: leave empty (module targets a retired feed shape; see README).
WORDFENCE_API_KEY=

# --- Origins and embedding ---
# Public origin of this tool, e.g. https://audit.offshorly.com. Must be https for report email.
PUBLIC_ORIGIN=
# Extra allowed request origins, space-separated. Dev: http://localhost:5173 http://localhost:8787
ALLOWED_ORIGINS=
# Sites allowed to iframe the tool (CSP frame-ancestors), space-separated.
ALLOWED_FRAME_ANCESTORS=https://offshorly.com https://www.offshorly.com

# --- Limits ---
RATE_LIMIT_HOURLY=5
RATE_LIMIT_DAILY=20
# AI audits per UTC day across all visitors. 50 until real cost numbers exist.
DAILY_AI_AUDITS=50
MAX_CONCURRENT_AUDITS=4
CACHE_TTL_MIN=360
# Proxy hops in front of the app (Render = 1). 0 = ignore X-Forwarded-For.
TRUST_PROXY_HOPS=1

# --- Optional features ---
# Adobe Fonts kit CSS URL. Empty = self-hosted Urbanist only.
TYPEKIT_KIT_URL=

# --- Runtime ---
PORT=8787
NODE_ENV=development
LOG_LEVEL=info
