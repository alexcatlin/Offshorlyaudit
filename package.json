{
  "name": "offshorly-audit",
  "version": "0.1.0",
  "private": true,
  "description": "Offshorly website audit widget: security, website health and AI opportunities.",
  "type": "module",
  "engines": {
    "node": "20.x"
  },
  "scripts": {
    "dev": "concurrently -k -n server,client -c blue,magenta \"PORT=8787 tsx watch server/index.ts\" \"vite\"",
    "build": "vite build && tsc -p tsconfig.server.json",
    "start": "NODE_ENV=production node dist/server/index.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "harness": "tsx scripts/harness.ts",
    "twenty:check": "tsx scripts/twenty-check.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.11.0",
    "@fastify/static": "^10.1.12",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/urbanist": "^5.3.0",
    "fastify": "^5.12.8",
    "preact": "^11.2.0",
    "undici": "^7.30.2"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^20.19.43",
    "concurrently": "^9.2.5",
    "tsx": "^4.23.15",
    "typescript": "~5.9",
    "vite": "^8.3.8",
    "vitest": "^4.1.12"
  }
}
